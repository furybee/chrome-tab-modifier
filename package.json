{
  "name": "tabee",
  "private": true,
  "version": "1.1.9",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "watch:test": "vitest",
    "watch:coverage": "npx vitest --coverage.enabled true",
    "coverage": "npx vitest --run --coverage.enabled true",
    "dev": "rm -rf ./dist && vite",
    "tsc": "vue-tsc",
    "lint": "eslint src",
    "format:check": "prettier --check src",
    "build": "rm -rf ./dist && vite build",
    "preview": "vite preview",
    "build-zip": "rm -rf ./dist && rm -f tabee.zip && npm run build && cd ./dist && zip -r ../tabee.zip *"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.0.268",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "cross-spawn": "^7.0.5"
  }
}
